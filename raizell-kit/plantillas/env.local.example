# Variables del front para hablar con el CMS de Raizell.
#
# Este fichero (.env.local.example) se versiona: lleva NOMBRES y las dos
# direcciones, que no son secretas. Las claves van en .env.local, que NO se
# versiona, y las rellenas tú a mano.
# Cómo conseguir cada cosa: raizell-kit/CHECKLIST.md
#
# 🔴 Ninguna clave lleva el prefijo NEXT_PUBLIC_: todo lo que lo lleva viaja
#    al navegador de cada visitante.

# Clave pública del site: lee solo lo publicado. (CHECKLIST 4)
RAIZELL_API_KEY=

# Clave de previsualización: lee también borradores. (CHECKLIST 5)
RAIZELL_PREVIEW_KEY=

# Direcciones de la API y de los medios (imágenes y documentos). Las trae
# puestas el kit; no hace falta pedirlas. (CHECKLIST 6)
RAIZELL_API_URL=
MEDIA_BASE_URL=
